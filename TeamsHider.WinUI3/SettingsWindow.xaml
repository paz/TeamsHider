<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TeamsHider.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TeamsHider">

    <!-- Outer border handles rounded corners and masks any edge artifacts -->
    <Border Background="#2B2B2B" CornerRadius="8" Margin="-1">
        <Grid Padding="12">
            <StackPanel Spacing="10">

                <!-- Status Card - Fluent card styling -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusIndicator"
                                 Width="8" Height="8"
                                 Fill="{ThemeResource SystemFillColorNeutralBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="StatusText"
                                   Text="Initializing..."
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Grid>
                </Border>

                <!-- Settings Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6">
                    <StackPanel Spacing="0">
                        <ToggleSwitch x:Name="HideTopBarToggle"
                                      Header="Hide top bar"
                                      OnContent="On" OffContent="Off"
                                      Toggled="OnHideTopBarToggled"
                                      MinWidth="0" MinHeight="0"/>
                        <ToggleSwitch x:Name="HideBottomOverlayToggle"
                                      Header="Hide bottom overlay"
                                      OnContent="On" OffContent="Off"
                                      Toggled="OnHideBottomOverlayToggled"
                                      MinWidth="0" MinHeight="0"/>
                        <ToggleSwitch x:Name="LaunchAtStartupToggle"
                                      Header="Start with Windows"
                                      OnContent="On" OffContent="Off"
                                      Toggled="OnLaunchAtStartupToggled"
                                      MinWidth="0" MinHeight="0"/>
                    </StackPanel>
                </Border>

                <!-- Footer: GitHub, Version, Exit -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <HyperlinkButton Content="GitHub"
                                         NavigateUri="https://github.com/mroter93/TeamsHider"
                                         FontSize="11"
                                         Padding="2,0"/>
                        <TextBlock Text="·"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   FontSize="11"/>
                        <TextBlock x:Name="VersionText"
                                   Text="v5.0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Opacity="0.6"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="ExitButton"
                            Content="Exit"
                            FontSize="11"
                            Padding="12,4"
                            Click="OnExitClicked"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
