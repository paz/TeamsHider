<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TeamsHider.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TeamsHider">

    <!-- Transparent to let window's acrylic backdrop show through -->
    <Grid Background="Transparent" Padding="16">
        <StackPanel Spacing="12">

            <!-- Status Card - Fluent card styling -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusIndicator"
                             Width="8" Height="8"
                             Fill="{ThemeResource SystemFillColorNeutralBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               x:Name="StatusText"
                               Text="Initializing..."
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </Grid>
            </Border>

            <!-- Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="HideTopBarToggle"
                                  Header="Hide top bar"
                                  OnContent="On" OffContent="Off"
                                  Toggled="OnHideTopBarToggled"
                                  MinWidth="0" MinHeight="0"/>
                    <ToggleSwitch x:Name="HideBottomOverlayToggle"
                                  Header="Hide bottom overlay"
                                  OnContent="On" OffContent="Off"
                                  Toggled="OnHideBottomOverlayToggled"
                                  MinWidth="0" MinHeight="0"/>
                    <ToggleSwitch x:Name="LaunchAtStartupToggle"
                                  Header="Start with Windows"
                                  OnContent="On" OffContent="Off"
                                  Toggled="OnLaunchAtStartupToggled"
                                  MinWidth="0" MinHeight="0"/>
                </StackPanel>
            </Border>

            <!-- Footer: GitHub + Version -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <HyperlinkButton Content="GitHub"
                                 NavigateUri="https://github.com/mroter93/TeamsHider"
                                 FontSize="12"
                                 Padding="4,2"/>
                <TextBlock Text="·"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           FontSize="12"/>
                <TextBlock x:Name="VersionText"
                           Text="v5.0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.6"/>
            </StackPanel>

            <!-- Exit Button -->
            <Button x:Name="ExitButton"
                    Content="Exit"
                    HorizontalAlignment="Stretch"
                    Click="OnExitClicked"/>

        </StackPanel>
    </Grid>
</Window>
