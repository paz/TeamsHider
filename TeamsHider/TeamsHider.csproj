<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>TeamsHider</AssemblyName>
        <RootNamespace>TeamsHider</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Version>5.0.0</Version>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>x64</PlatformTarget>
      <DebugType>none</DebugType>
      <DebugSymbols>false</DebugSymbols>

      <!--
        Single-file publishing only for self-contained builds.
        Framework-dependent builds stay as multiple files for smaller size.
      -->
      <PublishSingleFile Condition="'$(SelfContained)' == 'true'">true</PublishSingleFile>
      <IncludeNativeLibrariesForSelfExtract Condition="'$(SelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
      <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>

      <!--
        Size optimizations (trimming not supported for Windows Forms)
        See: https://aka.ms/dotnet-illink/windows-forms
      -->
      <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="tray.ico" />
      <None Update="invisible.ico">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="JsonConfig" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="default.conf" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="settings.conf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>